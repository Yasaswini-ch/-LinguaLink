# Base URL of the deployed FastAPI backend, WITHOUT a trailing slash.
# Leave unset for local dev — Vite's proxy (vite.config.js) forwards
# /api -> http://localhost:8000 automatically.
# In production (e.g. a Vercel deploy of this frontend), set this to wherever
# you deployed demo/backend (Render, Railway, Fly.io, etc.) — see README.md's
# Deployment section for why the backend can't live on Vercel itself.
VITE_API_BASE_URL=https://your-backend-host.example.com
